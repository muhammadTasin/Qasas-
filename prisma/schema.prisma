generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ReactionType {
  LOVE
  SORROW
  ANGRY
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String?
  accounts Account[]
  name         String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  stories      Story[]
  reactions    Reaction[]
  comments     Comment[]
  storyViews   StoryView[]
  siteVisitors SiteVisitor[]
  // Last server-authenticated site visit, retained across browser/account switches.
  siteLastSeenAt DateTime?

  @@index([siteLastSeenAt])
}

model Story {
  id               String      @id @default(cuid())
  authorId         String
  title            String
  content          String
  totalReadSeconds Int         @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?
  publishKey       String?     @unique
  author           User        @relation(fields: [authorId], references: [id])
  reactions        Reaction[]
  comments         Comment[]
  views            StoryView[]

  @@index([authorId])
  @@index([createdAt])
  @@index([deletedAt, createdAt])
}

model Reaction {
  id        String       @id @default(cuid())
  storyId   String
  userId    String
  type      ReactionType
  createdAt DateTime     @default(now())
  story     Story        @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id])

  @@unique([storyId, userId])
  @@index([storyId])
}

model Comment {
  id        String   @id @default(cuid())
  storyId   String
  userId    String
  body      String
  createdAt DateTime @default(now())
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([storyId])
  @@index([createdAt])
}

model StoryView {
  id               String   @id @default(cuid())
  storyId          String
  userId           String?
  visitorId        String?
  ipHash           String?
  userAgent        String?
  deviceType       String?
  deviceModel      String?
  devicePlatform   String?
  deviceArchitecture String?
  isAuthenticated  Boolean?
  os               String?
  browser          String?
  country          String?
  region           String?
  city             String?
  firstSeenAt      DateTime @default(now())
  lastSeenAt       DateTime @updatedAt
  totalReadSeconds Int      @default(0)
  lastReadAt       DateTime?
  story            Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([storyId, visitorId])
  @@unique([storyId, ipHash])
  @@index([storyId])
  @@index([lastSeenAt])
  @@index([storyId, lastSeenAt])
  @@index([storyId, userId, lastSeenAt])
  @@index([userId])
}

model SiteVisitor {
  id          String   @id @default(cuid())
  // Last authenticated account for counting only; retained after logout.
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  visitorId   String?
  ipHash      String?
  userAgent   String?
  deviceType  String?
  deviceModel     String?
  devicePlatform  String?
  isAuthenticated Boolean?
  os          String?
  browser     String?
  country     String?
  region      String?
  city        String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt
  lastEventAt     DateTime?

  @@unique([visitorId])
  @@unique([ipHash])
  @@index([lastSeenAt])
  @@index([firstSeenAt])
  @@index([userId, lastSeenAt])
}

model SiteVisitEvent {
  id        String   @id @default(cuid())
  visitorId String?
  ipHash    String?
  pathname        String?
  isAuthenticated Boolean?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}
